GROQ_API_KEY=<tu_api_key_de_groq>

# "groq" (nube, gasta cuota) o "ollama" (local, requiere tener Ollama instalado y corriendo)
LLM_PROVIDER=groq
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# Debe ser exactamente el mismo valor que CHATBOT_INTERNAL_SECRET en backend/.env.
# Protege los endpoints /admin/documentos para que solo el backend pueda usarlos.
CHATBOT_INTERNAL_SECRET=<genera_un_secreto_largo_y_aleatorio>
