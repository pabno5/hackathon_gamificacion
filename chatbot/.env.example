GROQ_API_KEY=<tu_api_key_de_groq>

# "groq" (nube, gasta cuota) o "ollama" (local, requiere tener Ollama instalado y corriendo)
LLM_PROVIDER=groq
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# Debe ser exactamente el mismo valor que CHATBOT_INTERNAL_SECRET en backend/.env.
# Protege los endpoints /admin/documentos para que solo el backend pueda usarlos.
CHATBOT_INTERNAL_SECRET=<genera_un_secreto_largo_y_aleatorio>

# Orígenes del sitio público autorizados a consultar el chatbot (separados por coma).
# Sin definir, solo desarrollo local.
CHATBOT_CORS_ORIGINS=

# Límite de consultas a /buscar por IP: máximo N consultas cada VENTANA segundos.
CHATBOT_RATE_LIMIT_MAX=20
CHATBOT_RATE_LIMIT_WINDOW=60
# true SOLO si el servicio corre detrás de un proxy (Railway): lee la IP real de
# X-Forwarded-For. Sin proxy déjalo en false o el límite se puede saltar.
CHATBOT_TRUST_PROXY=false
