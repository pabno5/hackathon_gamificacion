# ==================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - FIREBASE
# ==================================================
# Copia este archivo como .env y configura tus valores
# Comando: cp env.config.example .env
# ==================================================

# Configuración del servidor
PORT=3000
NODE_ENV=development

# ===== FIREBASE CLIENT CONFIG (para el frontend) =====
# Obtén estos valores desde Firebase Console > Configuración del proyecto > Tus apps
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ===== FIREBASE ADMIN SDK (para el backend) =====
# OPCIÓN 1: Ruta al archivo de credenciales (recomendado para desarrollo)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-credentials.json

# OPCIÓN 2: JSON completo como string (recomendado para producción/deploy)
# Descarga el JSON desde Firebase Console > Configuración del proyecto > Cuentas de servicio
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"tu-proyecto","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# ===== SUPABASE =====
# Conexión a PostgreSQL usando Transaction Pooler de Supabase
# Obtén esto desde: Settings > Database > Connection string > Transaction pooler
SUPABASE_DATABASE_URL=postgresql://postgres.[REFERENCIA]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# URL del proyecto de Supabase (para Storage y otros servicios)
# Obtén esto desde: Settings > API > Project URL
SUPABASE_PROJECT_URL=https://[REFERENCIA].supabase.co

# Service Role Key (para acceso completo al Storage)
# Obtén esto desde: Settings > API > service_role key
SUPABASE_SERVICE_KEY=tu_service_role_key_de_supabase

# OPCIONAL: Anon key (para acceso público)
SUPABASE_ANON_KEY=tu_anon_key_de_supabase

# ===== GOOGLE CALENDAR (OPCIONAL) =====
# Para sincronización bidireccional con Google Calendar
# Opción 1: Ruta al archivo de credenciales de Service Account
GOOGLE_CALENDAR_CREDENTIALS_PATH=./config/google-calendar-credentials.json

# Opción 2: Credenciales como JSON string (para producción)
# GOOGLE_CALENDAR_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ID del calendario (usa 'primary' para el calendario principal)
GOOGLE_CALENDAR_ID=primary

# Zona horaria (default: America/Bogota)
TIMEZONE=America/Bogota

# ==================================================
# IMPORTANTE:
# - NUNCA subas el archivo .env a Git
# - NUNCA subas firebase-credentials.json a Git
# - NUNCA subas google-calendar-credentials.json a Git
# - Agrega todos al .gitignore
# ==================================================



