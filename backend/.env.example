SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
SUPABASE_PROJECT_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_jwt>
SUPABASE_ANON_KEY=<anon_jwt>

PORT=3000
NODE_ENV=development

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google-calendar-credentials.json
GOOGLE_CALENDAR_ID=<calendar_id>
TIMEZONE=America/Bogota
GOOGLE_CALENDAR_AUTO_SYNC=true
GOOGLE_CALENDAR_SYNC_INTERVAL=*/15 * * * *

# Callcenter IA (n8n/Vapi) — BE-03
CALLCENTER_API_KEY=cambia-esta-clave-en-produccion

# Chatbot (servicio Python en puerto 8000)
CHATBOT_URL=http://localhost:8000
# Debe ser idéntico a CHATBOT_INTERNAL_SECRET en chatbot/.env
CHATBOT_INTERNAL_SECRET=<genera_un_secreto_largo_y_aleatorio>
